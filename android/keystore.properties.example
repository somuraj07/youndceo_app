# Copy to keystore.properties and fill in your Play Store signing values.
# Generate a keystore once with:
# keytool -genkey -v -keystore young-ceo-release.keystore -alias youngceo -keyalg RSA -keysize 2048 -validity 10000

storeFile=../young-ceo-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=youngceo
keyPassword=YOUR_KEY_PASSWORD
